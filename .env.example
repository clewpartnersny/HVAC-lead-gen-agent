# ─────────────────────────────────────────────────────────────────────────────
# HVAC Lead-Gen Agent — environment configuration
# Copy to .env for local runs. In GitHub Actions these are set as repo Secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- API keys -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Google Maps data provider. Set whichever you have — "auto" prefers Serper.
# Get a Serper key at https://serper.dev (uses its /maps endpoint).
SERPER_API_KEY=
# Alternative provider (only if you use Outscraper instead):
OUTSCRAPER_API_KEY=
# Force a provider if you set both: serper | outscraper | auto
MAPS_PROVIDER=auto

# RocketReach — verified owner-email lookup (optional). Leave blank to skip.
ROCKETREACH_API_KEY=

# --- Google auth --------------------------------------------------------------
# RUN-IT-YOURSELF (default): "sign in with Google" once in a browser. Download an
# OAuth client (Desktop app) and save it as client_secret.json; the first run
# caches a token to token.json. See README → "Run it yourself".
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
#
# UNATTENDED 24/7 (optional, for later): a service account instead of OAuth.
# Paste the FULL service-account JSON here, or point to a file on disk.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Google Sheets ------------------------------------------------------------
# The spreadsheet that holds your "Organized MSAs" list.
MSA_SHEET_ID=
MSA_WORKSHEET=Organized MSAs
# Column in the MSA sheet that contains the metro name (auto-detected if blank).
MSA_NAME_COLUMN=

# The output spreadsheet. Its first tab's header row must mirror the
# "Research Template" columns. Qualified companies are appended here.
OUTPUT_SHEET_ID=
OUTPUT_WORKSHEET=Leads
# A tab in the OUTPUT sheet used to checkpoint progress across runs.
STATE_WORKSHEET=_agent_state
# A tab for companies we couldn't confidently qualify (manual review).
REVIEW_WORKSHEET=Needs Review

# --- Search / qualification tuning -------------------------------------------
# Minimum estimated annual revenue (USD) to keep a company.
MIN_REVENUE_USD=5000000
# How many MSAs to process per run (keeps each GitHub Actions job under its limit).
MAX_MSAS_PER_RUN=2
# Max Google Maps results to pull per MSA query.
RESULTS_PER_QUERY=200
# Search terms run against each MSA (comma-separated).
SEARCH_TERMS=HVAC contractor,heating and air conditioning,HVAC service
# Model used for qualification.
ANTHROPIC_MODEL=claude-opus-4-8
# Set to "1" to run a single MSA with verbose logging and no sheet writes.
DRY_RUN=0
